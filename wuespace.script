# WüSpace Plymouth Boot Theme
# Script Plugin Implementation

# Background gradient: BG1 #1E1E2E -> BG2 #182D4A
Window.SetBackgroundTopColor(0.1176, 0.1176, 0.1804);
Window.SetBackgroundBottomColor(0.0941, 0.1765, 0.2902);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Load static image
static_image = Image("static.png");

# Load animated frames
NUM_FRAMES = @num_frames@;
progress_images = [];
for (i = 0; i < NUM_FRAMES; i++) {
  progress_images[i] = Image("frame_" + i + ".png");
}

# Main logo sprite
logo_sprite = Sprite();
logo_width = progress_images[0].GetWidth();
logo_height = progress_images[0].GetHeight();

logo_x = (screen_width / 2) - (logo_width / 2);
logo_y = (screen_height / 2) - (logo_height / 2) - 40;

logo_sprite.SetPosition(logo_x, logo_y, 10);
logo_sprite.SetImage(progress_images[0]);

# Animation state
current_mode = "normal";
current_frame = 0.0;
ANIMATION_SPEED = 1.0; # 1 frame per tick at 50-60Hz (ultra-smooth 60 FPS animation)

# Refresh callback for animation
fun refresh_callback () {
  if (current_mode == "normal") {
    frame_index = Math.Int(current_frame) % NUM_FRAMES;
    logo_sprite.SetImage(progress_images[frame_index]);
    current_frame = (current_frame + ANIMATION_SPEED);
    if (current_frame >= NUM_FRAMES)
      current_frame = current_frame - NUM_FRAMES;
  } else {
    logo_sprite.SetImage(static_image);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

# --- Password and Prompt Dialog Handling (e.g. LUKS disk decryption) ---
bullet_image = Image("bullet.png");

# Colored curly brackets [#F9A877 -> RGB(0.9765, 0.6588, 0.4667)] rendered as text on the fly
bracket_left_image = Image.Text("{", 0.9765, 0.6588, 0.4667, 1.0, "Sans Bold 20");
bracket_right_image = Image.Text("}", 0.9765, 0.6588, 0.4667, 1.0, "Sans Bold 20");

prompt_sprite = Sprite();
prompt_sprite.SetZ(20);

bracket_left_sprite = Sprite(bracket_left_image);
bracket_left_sprite.SetZ(20);
bracket_left_sprite.SetOpacity(0.0);

bracket_right_sprite = Sprite(bracket_right_image);
bracket_right_sprite.SetZ(20);
bracket_right_sprite.SetOpacity(0.0);

bullet_sprites = [];

fun display_password_callback (prompt_text, bullet_count) {
  current_mode = "password";
  logo_sprite.SetImage(static_image);

  if (prompt_text)
    prompt_img = Image.Text(prompt_text, 1.0, 1.0, 1.0, 1.0, "Sans 12");
  else
    prompt_img = Image.Text("Passphrase:", 1.0, 1.0, 1.0, 1.0, "Sans 12");

  prompt_sprite.SetImage(prompt_img);
  prompt_x = (screen_width / 2) - (prompt_img.GetWidth() / 2);
  prompt_y = logo_y + logo_height + 20;
  prompt_sprite.SetPosition(prompt_x, prompt_y, 20);
  prompt_sprite.SetOpacity(1.0);

  # Bullets and brackets rendering
  bullet_width = bullet_image.GetWidth();
  bullet_height = bullet_image.GetHeight();
  bullet_spacing = 8;
  bracket_width = bracket_left_image.GetWidth();
  bracket_height = bracket_left_image.GetHeight();
  bracket_padding = 6;
  bullet_y = prompt_y + prompt_img.GetHeight() + 15;
  bracket_y = bullet_y + (bullet_height / 2) - (bracket_height / 2);

  if (bullet_count > 0) {
    total_bullets_width = bullet_count * (bullet_width + bullet_spacing) - bullet_spacing;
    total_field_width = total_bullets_width + (2 * bracket_width) + (2 * bracket_padding);
    start_field_x = (screen_width / 2) - (total_field_width / 2);
    left_bracket_x = start_field_x;
    start_bullet_x = left_bracket_x + bracket_width + bracket_padding;
    right_bracket_x = start_bullet_x + total_bullets_width + bracket_padding;
  } else {
    empty_gap = 16;
    total_field_width = (2 * bracket_width) + empty_gap;
    start_field_x = (screen_width / 2) - (total_field_width / 2);
    left_bracket_x = start_field_x;
    start_bullet_x = left_bracket_x + bracket_width + bracket_padding;
    right_bracket_x = start_field_x + bracket_width + empty_gap;
  }

  bracket_left_sprite.SetPosition(left_bracket_x, bracket_y, 20);
  bracket_left_sprite.SetOpacity(1.0);

  bracket_right_sprite.SetPosition(right_bracket_x, bracket_y, 20);
  bracket_right_sprite.SetOpacity(1.0);

  for (i = 0; i < 64; i++) {
    if (bullet_sprites[i]) {
      if (i < bullet_count) {
        bullet_sprites[i].SetPosition(start_bullet_x + i * (bullet_width + bullet_spacing), bullet_y, 20);
        bullet_sprites[i].SetOpacity(1.0);
      } else {
        bullet_sprites[i].SetOpacity(0.0);
      }
    } else if (i < bullet_count) {
      bullet_sprites[i] = Sprite(bullet_image);
      bullet_sprites[i].SetPosition(start_bullet_x + i * (bullet_width + bullet_spacing), bullet_y, 20);
      bullet_sprites[i].SetOpacity(1.0);
    }
  }
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

# --- Normal Display Callback (hide dialogs) ---
fun display_normal_callback () {
  current_mode = "normal";
  prompt_sprite.SetOpacity(0.0);
  bracket_left_sprite.SetOpacity(0.0);
  bracket_right_sprite.SetOpacity(0.0);
  for (i = 0; i < 64; i++) {
    if (bullet_sprites[i])
      bullet_sprites[i].SetOpacity(0.0);
  }
  if (message_sprite)
    message_sprite.SetOpacity(0.0);
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);

# --- Display Question Callback ---
fun display_question_callback (prompt_text, input_text) {
  current_mode = "question";
  logo_sprite.SetImage(static_image);

  text = prompt_text + " " + input_text;
  prompt_img = Image.Text(text, 1.0, 1.0, 1.0, 1.0, "Sans 12");
  prompt_sprite.SetImage(prompt_img);
  prompt_x = (screen_width / 2) - (prompt_img.GetWidth() / 2);
  prompt_y = logo_y + logo_height + 20;
  prompt_sprite.SetPosition(prompt_x, prompt_y, 20);
  prompt_sprite.SetOpacity(1.0);
}

Plymouth.SetDisplayQuestionFunction(display_question_callback);

# --- System Message Callback (fsck, kernel status, etc.) ---
message_sprite = Sprite();
message_sprite.SetZ(20);

fun message_callback (text) {
  msg_img = Image.Text(text, 0.8, 0.8, 0.8, 1.0, "Sans 10");
  message_sprite.SetImage(msg_img);
  msg_x = (screen_width / 2) - (msg_img.GetWidth() / 2);
  msg_y = screen_height - msg_img.GetHeight() - 30;
  message_sprite.SetPosition(msg_x, msg_y, 20);
  message_sprite.SetOpacity(1.0);
}

Plymouth.SetMessageFunction(message_callback);

# --- Quit Callback ---
fun quit_callback () {
  logo_sprite.SetOpacity(0.0);
  prompt_sprite.SetOpacity(0.0);
  bracket_left_sprite.SetOpacity(0.0);
  bracket_right_sprite.SetOpacity(0.0);
  if (message_sprite)
    message_sprite.SetOpacity(0.0);
}

Plymouth.SetQuitFunction(quit_callback);
